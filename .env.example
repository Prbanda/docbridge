# Local only. Copy to .env:  cp .env.example .env
# Defaults work as-is. AWS uses Secrets Manager — these stay on your machine.

# Postgres major version (match RDS in infra/envs/*/variables.tf).
POSTGRES_VERSION=17

# Superuser for the local Postgres container (init + admin).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-dev-only

# Per-service DB role passwords (ADR-009). Used by init-databases.sh and compose.
AUTH_DB_PASSWORD=auth-local-dev
PLATFORM_DB_PASSWORD=platform-local-dev
DOCBRIDGE_DB_PASSWORD=docbridge-local-dev

# Service-client secrets (ADR-013). Local-only values; AWS generates real ones in Secrets Manager.
DELIVERY_WORKER_CLIENT_SECRET=delivery-worker-local-dev
DOCBRIDGE_API_CLIENT_SECRET=docbridge-api-local-dev
PLATFORM_ADMIN_CLIENT_SECRET=platform-admin-local-dev

# Delivery retry backoff in seconds (attempt 1 → 2, 2 → 3). AWS uses 60,300; locally shorter so drills are quick.
RETRY_BACKOFF_SECONDS=10,20
